# Copy this file to .env (npm run setup does it for you). Never commit .env.

# ---------------------------------------------------------------- AI (one key is enough)
# Reads the customer's message or screenshot and matches it to your products.
# Free: Gemini, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or OpenAI (https://platform.openai.com/api-keys) or OpenRouter (https://openrouter.ai/keys)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# With several keys, the first one in this list answers; the next takes over when one runs out of credit.
# ASSIST_PROVIDERS=openai,gemini,openrouter
# Models, if you want others than the defaults (gpt-4.1-mini, gemini-2.5-flash, google/gemini-2.5-flash)
# ASSIST_MODEL_OPENAI=
# ASSIST_MODEL_GEMINI=
# ASSIST_MODEL_OPENROUTER=
# AI calls per person per hour. Keeps one person from spending all your credit.
ASSIST_LIMIT_PER_HOUR=40
# Browser mode online has no login, so Add with AI is off there. 1 turns it on anyway (anyone with the link can use it).
# ALLOW_PUBLIC_AI=

# ---------------------------------------------------------------- Supabase (optional)
# Leave these empty for browser mode: no login, data stays in the browser.
# Fill them (npm run setup:supabase does it) for login, a team and shared data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used by npm run setup:supabase.
# The access token is one-time, from https://supabase.com/dashboard/account/tokens. The setup removes it again.
# The project ref and database password are written by the setup. The password is optional later: the setup can also use the access token.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# The owner's login email. Only this email can create the owner account.
OWNER_EMAIL=
